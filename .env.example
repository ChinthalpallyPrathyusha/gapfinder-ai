# Database (Neon / Supabase Serverless Postgres)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Groq LLM API Key (Required for AI generation, evaluation, & explanations)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY="gsk_..."

# Authentication Secret (Used for signing JWT session tokens)
# Generate one with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# (Optional) Embeddings API Key (for hybrid vector retrieval alongside BM25)
# GEMINI_API_KEY="AIza..."
